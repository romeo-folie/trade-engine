# TradeEngine environment configuration example.
# Copy this file to .env and fill in your own values before running locally.
# Keep secrets (API keys, tokens, secrets) out of version control.

# --- PostgreSQL / Docker defaults ------------------------------------------------
# These values are only used when spinning up the bundled postgres instance.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tradeengine
POSTGRES_PORT=5432

# Override the main database connection string when your Postgres is elsewhere.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tradeengine?sslmode=disable

# --- LLM provider --------------------------------------------------------------
# Anthropic is the primary analyst by default. Provide your Anthropic API key here.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Broker / market keys ------------------------------------------------------
# Alpaca (paper or live trading). Required if you run the stocks strategies.
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Polymarket (prediction markets). Only needed if predictions.polymarket.enabled=true.
POLYMARKET_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLYMARKET_API_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Kalshi (prediction markets). Optional component.
KALSHI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Data & notifications -----------------------------------------------------
# Finnhub is the default news provider.
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram bot used for signal/summary notifications.
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
