# ─── Compiled binaries ────────────────────────────────────────────────────────
# Main binary (see Makefile: BINARY := te)
/te

# ─── Secrets & local config ───────────────────────────────────────────────────
# Never commit real credentials. Keep config.example.yaml as the tracked template.
.env
.env.*
!.env.example

config.yaml
!config.example.yaml

# Local override files (convention for per-machine settings)
*.local.yaml
*.local.toml
*.local.env

# ─── Go build artifacts ───────────────────────────────────────────────────────
# Test binaries (go test -c)
*.test

# Test coverage and profiling output
coverage.out
coverage.html
*.prof
*.pprof
cpu.out
mem.out

# Vendor directory (if go mod vendor is ever used)
vendor/

# ─── Database & runtime ───────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# Log files
*.log
logs/

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ─── IDEs & editors ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Temporary files
tmp/
.tmp/
node_modules/

internal/web/test_config.yaml

# Claude Code local settings
.claude/settings.local.json

# IBKR account statements (financial PII) — never commit
data/*.csv

# stray local build binaries
/orb-reconcile-statement
/orb-backfill
te-study

# Generated frontend bundles. Vite writes directly to the Go embed target.
/web/frontend/dist/
/internal/web/dist/*
!/internal/web/dist/.gitkeep
